<h1><%= @attempt.mock.title %>: result</h1>
<p><%= notice %></p>
<p><strong>Score: <%= @attempt.score %> / <%= @attempt.answers.size %>
  (<%= @attempt.percentage %>%)</strong></p>

<h2>By competency</h2>
<table>
  <tr><th>Competency</th><th>Correct</th><th>%</th></tr>
  <% @breakdown.each do |comp, correct, total| %>
    <tr>
      <td><%= comp.name %></td>
      <td><%= correct %> / <%= total %></td>
      <td><%= (correct * 100.0 / total).round %>%</td>
    </tr>
  <% end %>
</table>

<h2>Review</h2>
<% @answers.each do |a| %>
  <div>
    <p><strong><%= a.position %>.</strong> <%= a.question.body %>
      <em>(<%= a.question.subtopic.name %>)</em></p>
    <p>Your answer: <%= a.option&.body || "not answered" %> <%= a.correct? ? "✓" : "✗" %></p>
    <% unless a.correct? %>
      <p>Correct answer: <%= a.question.options.detect(&:correct)&.body %></p>
    <% end %>
    <% if a.question.explanation.present? %>
      <p>Explanation: <%= a.question.explanation %></p>
    <% end %>
    <hr>
  </div>
<% end %>

<%= link_to "Back to mocks", mocks_path %>
