<%= form_with model: [:manage, question] do |f| %>
  <% if question.errors.any? %>
    <ul><% question.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
  <% end %>

  <p><%= f.label :subtopic_id, "Subtopic" %><br>
    <%= f.grouped_collection_select :subtopic_id, Competency.order(:position).includes(:subtopics), :subtopics, :name, :id, :name %></p>
  <p><%= f.label :body, "Question" %><br><%= f.text_area :body, rows: 4, cols: 80 %></p>

  <p>Options (tick the one correct answer):</p>
  <%= f.fields_for :options do |o| %>
    <p><%= o.hidden_field :id if o.object.persisted? %>
      <%= o.text_field :body, size: 70 %> <%= o.check_box :correct %></p>
  <% end %>

  <p><%= f.label :explanation %><br><%= f.text_area :explanation, rows: 3, cols: 80 %></p>
  <p><%= f.select :difficulty, Question.difficulties.keys %>
     <%= f.select :status, Question.statuses.keys %></p>
  <%= f.submit %>
<% end %>
